module fwft_fifo_wrapper #(
    parameter DATA_WIDTH = 32,
    parameter DEPTH      = 16,
    parameter LATENCY 	 = 0, 

)(
    input  logic                    clk,
    input  logic                    arst_n,
    input  logic [DATA_WIDTH-1:0]   wr_data,
    input  logic                    wr_en,
    output logic                    full,
    output logic [DATA_WIDTH-1:0]   rd_data,
    input  logic                    rd_en,
    output logic                    empty
);


//prefechting logic 
    logic [DATA_WIDTH-1:0] sc_rd_data;
    logic                  sc_rd_en;
    logic                  sc_empty;
    
    logic [DATA_WIDTH-1:0] middle_reg;
    logic                  middle_valid;

    logic tfull;
    logic ovf;
    logic tempty;
    logic udf;
    logic [$clog2(DEPTH):0] num_vld;
    logic init_done;
    logic sec;
    logic ded;
sfifo #(
    .DEPTH(DEPTH),
    .DATA_WIDTH(DATA_WIDTH),
    .LATENCY(LATENCY)
    )
     sfifo (
    .clk      (clk      ),
    .arst_n   (arst_n   ),
    .wr       (wr_en    ),
    .wr_data  (wr_data  ),
    .full     (full     ),
    .tfull    (tfull    ),
    .ovf      (ovf      ),
    .rd       (sc_rd_en    ),
    .rd_data  (sc_rd_data  ),
    .empty    (sc_empty    ),
    .tempty   (tempty   ),
    .udf      (udf      ),
    .num_vld  (num_vld  ),
    .init_done(init_done),
    .sec      (sec      ),
    .ded      (ded      )
);

    // The standard FIFO must read ahead whenever our FWFT output or middle register is empty
    assign sc_rd_en = !sc_empty && (!middle_valid || rd_en || empty);
    always_ff @(posedge clk or negedge arst_n) begin
        if (!arst_n) begin
            middle_valid <= 1'b0;
            middle_reg   <= '0;
            rd_data      <= '0;
            empty        <= 1'b1;
        end else begin
            // Update Middle Register
            if (sc_rd_en) begin
                middle_reg   <= sc_rd_data;
                middle_valid <= 1'b1;
            end else if (rd_en && !empty) begin
                middle_valid <= 1'b0;
            end
            // Update FWFT Output Stage
            if (sc_rd_en && (empty || rd_en)) begin
                rd_data <= sc_rd_data;
                empty   <= 1'b0;
end
             else if (middle_valid && (empty || rd_en)) begin
                rd_data      <= middle_reg;
                empty        <= 1'b0;
                middle_valid <= 1'b0; // pipeline advanced
            end 
		else if (rd_en) begin
                empty   <= 1'b1;
            end
        end
    end

endmodule